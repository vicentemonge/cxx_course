# course_module(<nombre>)
#   examples/*.cpp -> un ejecutable por fichero  (<modulo>_<fichero>)
#   tests/*.cpp    -> un ejecutable de tests doctest por módulo
function(course_module name)
  file(GLOB examples CONFIGURE_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/examples/*.cpp)
  foreach(src IN LISTS examples)
    get_filename_component(stem ${src} NAME_WE)
    set(target ${name}_${stem})
    add_executable(${target} ${src})
    target_include_directories(${target} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
    target_link_libraries(${target} PRIVATE course_common course_warnings)
  endforeach()

  file(GLOB tests CONFIGURE_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/tests/*.cpp)
  if(COURSE_BUILD_TESTS AND tests)
    set(target ${name}_tests)
    add_executable(${target} ${tests})
    target_include_directories(${target} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
    target_link_libraries(${target} PRIVATE course_common course_warnings doctest::doctest_with_main)
    add_test(NAME ${target} COMMAND ${target})
  endif()
endfunction()
